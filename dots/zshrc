# ============================================================================
# EDITOR
# ============================================================================

export EDITOR="nvim"
export VISUAL="nvim"
export COLORTERM="truecolor"


# ============================================================================
# PLUGINS
# ============================================================================
#
# There is no plugin manager any more. zinit used to bootstrap itself here by
# git-cloning into $XDG_DATA_HOME on first run, then load zsh-vi-mode,
# fast-syntax-highlighting and zsh-completions with turbo mode.
#
# All of those now come from the pinned nixpkgs and are loaded by
# modules/zsh.nix through zsh-defer, which also owns the ordering between them
# (see the comments there — the order is load-bearing and fails silently).
# zsh-completions is the exception: it ships completion *functions*, not a
# sourceable plugin, so modules/zsh.nix puts it on fpath in a mkBefore block
# that lands ahead of the compinit call below.


# ============================================================================
# COMPLETION & AUTOCOMPLETE
# ============================================================================

autoload -Uz compinit
if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qN.mh+24) ]]; then
    compinit
else
    compinit -C
fi

zstyle ':completion::complete:*' use-cache 1
zstyle ':completion::complete:*' cache-path ~/.zsh/cache
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' menu select
zstyle ':completion:*:default' list-colors ${(s.:.)LS_COLORS}



# ============================================================================
# KEYBINDINGS & SHORTCUTS
# ============================================================================

# Re-apply custom keybindings after zsh-vi-mode initialises
function zvm_after_init {
  export VIM_INSERT="I"

  # Tab is deliberately left unbound: fzf-tab (modules/zsh.nix) binds it, and
  # it loads later than this hook, so anything set here would just be overwritten.
  #
  # ^R is likewise unbound on purpose. `fzf --zsh` binds it to
  # fzf-history-widget in viins, and this hook runs AFTER that (zsh-vi-mode is
  # sourced from the mkOrder 1200 block), so re-binding it here would silently
  # shadow fzf's fuzzy history with zsh's much weaker incremental search.
  # ^S went with it — fzf has no forward-search equivalent.
  bindkey -M viins '^[[1;5C' forward-word
  bindkey -M viins '^[[1;5D' backward-word
  bindkey -M viins '^A' beginning-of-line
  bindkey -M viins '^E' end-of-line
  bindkey -M viins '^[e' end-of-line
  bindkey -M viins '^X^K' kill-line
  bindkey -M viins '^X^L' clear-screen
  bindkey -M viins '^U' kill-whole-line
  bindkey -M viins '^W' backward-kill-word
  bindkey -M viins '^[[3~' delete-char
  bindkey -M viins '^[[H' beginning-of-line
  bindkey -M viins '^[[F' end-of-line
}

# ============================================================================
# ALIASES
# ============================================================================

# Sudo
alias sudo='sudo '

# NLS
if command -v nls >/dev/null 2>&1; then
    alias ls='nls'
    alias ll='nls -l'
    alias la='nls -la'
elif command -v eza >/dev/null 2>&1; then
    alias ls='eza --color=always'
    alias ll='eza -la --color=always'
    alias la='eza -a --color=always'
else
    alias ls='ls --color=auto'
    alias ll='ls -la --color=auto'
    alias la='ls -a --color=auto'
fi

alias lt='eza --tree --color=always'

# System
alias grep='grep --color=auto'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias h='history'
alias j='jobs'
alias c='clear'
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

# Update & Rollback
alias update='cd /etc/nixos/ && nix flake update'
alias rollback='sudo nixos-rebuild switch --rollback'
alias flakeback='git -C /etc/nixos checkout -- flake.lock'

# Delete Old Rollback
alias gen-delete='sudo nix-env --profile /nix/var/nix/profiles/system --delete-generations +5 && sudo nix-collect-garbage && sudo nixos-rebuild boot'

# Programs
alias nv='nvim'
alias rb='reboot'
alias rt='riptide'
alias wm='wiremix'

# Git
alias g='git'
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git log --oneline'
alias gd='git diff'

# Lazygit
alias lg='lazygit'

# Tmux
alias tn='tmux new-session -A -s'
alias tk='tmux kill-session -t'

# ============================================================================
# FUNCTIONS
# ============================================================================

mkcd() {
    mkdir -p "$1" && cd "$1"
}

extract() {
    if [[ -f $1 ]]; then
        case $1 in
            *.tar.bz2) tar xjf $1 ;;
            *.tar.gz)  tar xzf $1 ;;
            *.bz2)     bunzip2 $1 ;;
            *.rar)     unrar x $1 ;;
            *.gz)      gunzip $1 ;;
            *.tar)     tar xf $1 ;;
            *.tbz2)    tar xjf $1 ;;
            *.tgz)     tar xzf $1 ;;
            *.zip)     unzip $1 ;;
            *.Z)       uncompress $1 ;;
            *.7z)      7z x $1 ;;
            *)         echo "Don't know how to extract '$1'" ;;
        esac
    else
        echo "'$1' is not a valid file"
    fi
}

# ============================================================================
# ADDITIONAL OPTIONS
# ============================================================================

setopt AUTO_CD
setopt CORRECT
setopt COMPLETE_IN_WORD
setopt ALWAYS_TO_END
setopt EXTENDED_GLOB

unsetopt BEEP

# ============================================================================
# PATH CONFIGURATION
# ============================================================================

[[ -d "$HOME/.local/bin" ]] && export PATH="$HOME/.local/bin:$PATH"
[[ -d "$HOME/bin" ]] && export PATH="$HOME/bin:$PATH"

# ============================================================================
# FINAL SETUP
# ============================================================================

function zvm_after_select_vi_mode {
  unset VIM_NORMAL VIM_INSERT VIM_VISUAL
  case $ZVM_MODE in
    $ZVM_MODE_NORMAL)      export VIM_NORMAL="N" ;;
    $ZVM_MODE_VISUAL)      export VIM_VISUAL="V" ;;
    $ZVM_MODE_VISUAL_LINE) export VIM_VISUAL="VL" ;;
    *)                     export VIM_INSERT="I" ;;
  esac
}

fastfetch

[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

alias cd='z'
